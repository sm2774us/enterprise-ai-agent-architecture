# Optional: point the frontend server at real backend services (defaults
# below match docker-compose.yml). Not required for the mock-only tabs.
AGENT_ORCHESTRATOR_URL=http://localhost:8000
CONTROL_TOWER_URL=http://localhost:8001
MCP_A2A_GATEWAY_URL=http://localhost:8002
LLM_GATEWAY_URL=http://localhost:8003

# Optional: enables real Gemini-backed completions in a couple of existing
# demo endpoints (server.ts). The app runs fully without it.
GEMINI_API_KEY=
